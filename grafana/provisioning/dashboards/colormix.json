    {
      "id": 12,
      "type": "table",
      "title": "Hasil tuning Cohen-Coon",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"K\", \"tau\", \"theta\", \"kp\", \"Ti\", \"Td\", \"ki\", \"kd\", \"step_ml\", \"vol\" FROM \"tuning\" GROUP BY \"pump\" ORDER BY time DESC LIMIT 5"
        }
      ],
      "options": {
        "showHeader": true,
