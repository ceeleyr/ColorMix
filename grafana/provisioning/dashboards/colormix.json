{
  "uid": "colormix-main",
  "title": "ColorMix – Paint Mixer",
  "tags": [
    "colormix"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total order",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT count(\"r\") FROM \"orders\" WHERE $timeFilter"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total cat diproduksi",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT sum(\"vol\") FROM \"orders\" WHERE $timeFilter"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ml",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Status ESP32",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"state\") AS \"state\" FROM \"esp_status\""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^state$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "gray"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "idle": {
                  "text": "IDLE",
                  "color": "green",
                  "index": 0
                },
                "mixing": {
                  "text": "MIXING",
                  "color": "orange",
                  "index": 1
                },
                "done": {
                  "text": "DONE",
                  "color": "blue",
                  "index": 2
                },
                "error": {
                  "text": "ERROR",
                  "color": "red",
                  "index": 3
                },
                "offline": {
                  "text": "OFFLINE",
                  "color": "dark-red",
                  "index": 4
                },
                "tuning": {
                  "text": "TUNING",
                  "color": "purple",
                  "index": 5
                },
                "priming": {
                  "text": "PRIMING",
                  "color": "yellow",
                  "index": 6
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Progress mixing",
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"progress\") AS \"progress\" FROM \"esp_status\""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^progress$/",
          "values": false
        },
        "showThresholdMarkers": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "WiFi RSSI",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "RSSI",
          "query": "SELECT mean(\"rssi\") FROM \"esp_status\" WHERE $timeFilter AND \"rssi\" < 0 GROUP BY time($__interval) fill(none)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -80
              },
              {
                "color": "green",
                "value": -67
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Nilai RGB per order",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col",
          "query": "SELECT \"r\" AS \"R\", \"g\" AS \"G\", \"b\" AS \"B\" FROM \"orders\" WHERE $timeFilter"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 255,
          "custom": {
            "drawStyle": "points",
            "pointSize": 9,
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "R"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "G"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Pigmen terpakai (ml)",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT sum(\"red_ml\") AS \"Merah\", sum(\"green_ml\") AS \"Hijau\", sum(\"blue_ml\") AS \"Biru\" FROM \"orders\" WHERE $timeFilter"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ml",
          "min": 0,
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Merah"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E53935"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hijau"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#43A047"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Biru"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1E88E5"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Order terbaru",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 16,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"order_id\" AS \"ID\", \"name\" AS \"Nama\", \"hex\" AS \"HEX\", \"r\" AS \"R\", \"g\" AS \"G\", \"b\" AS \"B\", \"vol\" AS \"Vol (ml)\", \"red_ml\" AS \"Merah (ml)\", \"green_ml\" AS \"Hijau (ml)\", \"blue_ml\" AS \"Biru (ml)\" FROM \"orders\" WHERE $timeFilter ORDER BY time DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Progress mixing (riwayat)",
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-colormix"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Progress",
          "query": "SELECT \"progress\" FROM \"esp_status\" WHERE $timeFilter"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "showPoints": "auto"
          }
        },
        "overrides": []
      }
    },
    {
