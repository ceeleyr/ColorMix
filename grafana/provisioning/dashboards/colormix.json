      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col",
          "query": "SELECT \"tr\" AS \"Target R\", \"tg\" AS \"Target G\", \"tb\" AS \"Target B\", \"yr\" AS \"Terukur R\", \"yg\" AS \"Terukur G\", \"yb\" AS \"Terukur B\" FROM \"color_pid\" WHERE $timeFilter"
