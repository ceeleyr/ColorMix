    "type": "function",
    "z": "tab_main",
    "name": "Hasil Cohen-Coon -> Influx",
    "func": "// Input: hasil Cohen-Coon / info (colormix/tune)\nconst t = msg.payload || {};\nif (t.type === \"tune\" && t.ok) {\n  flow.set(\"tune_\" + t.pump, t);\n  msg.payload = [{ K: t.K, Kv: t.Kv, tau: t.tau, theta: t.theta, kp: t.kp, Ti: t.Ti, Td: t.Td,\n                   ki: t.ki, kd: t.kd, step_ml: t.ml, vol: t.vol, dy: t.dy }, { pump: String(t.pump) }];\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
