  {
    "id": "simFn",
    "type": "function",
    "z": "tab_sim",
    "name": "Simulasi mixing",
    "func": "// Simulator ESP32: aktifkan tab ini untuk demo tanpa hardware.\nconst o = msg.payload;\nconst steps = [\"red\", \"green\", \"blue\"].filter(k => o.dose && o.dose[k] > 0);\nconst send = (state, progress, step) => node.send({\n  topic: \"colormix/status\",\n  payload: { device: \"esp32-sim\", state, order: o.id, progress, step, rssi: -50 }\n});\nsend(\"mixing\", 0, steps[0] || \"\");\nsteps.forEach((k, i) => setTimeout(() => send(\"mixing\", Math.round((i + 1) / steps.length * 100), k), (i + 1) * 1500));\nsetTimeout(() => send(\"done\", 100, \"\"), (steps.length + 1) * 1500);\nsetTimeout(() => send(\"idle\", 0, \"\"), (steps.length + 3) * 1500);\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 80,
    "wires": [
      [
        "simOut"
      ]
    ]
  },
  {
    "id": "simOut",
    "type": "mqtt out",
    "z": "tab_sim",
    "name": "colormix/status",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
