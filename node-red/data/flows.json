  {
    "id": "teleFn",
    "type": "function",
    "z": "tab_main",
    "name": "Telemetry -> Influx",
    "func": "// Input: telemetry PID dari ESP32-S3 (colormix/telemetry), tiap 0.5 s saat TRIM\nconst t = msg.payload || {};\nconst f = {};\nfor (const k of [\"tr\",\"tg\",\"tb\",\"yr\",\"yg\",\"yb\",\"mr\",\"mg\",\"mb\",\"ur\",\"ug\",\"ub\",\"err\"]) {\n  if (typeof t[k] === \"number\") f[k] = t[k];\n}\nif (!Object.keys(f).length) return null;\nmsg.payload = [f, { order: String(t.order || \"\"), phase: String(t.phase || \"\") }];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
