  {
    "id": "saveStatus",
    "type": "function",
    "z": "tab_main",
    "name": "Simpan status ESP32",
    "func": "// Input: status dari ESP32 di topic colormix/status\nconst s = (msg.payload && typeof msg.payload === \"object\") ? msg.payload : {};\ns.ts = Date.now();\nflow.set(\"espStatus\", s);\n\nconst codes = { offline: 0, idle: 1, mixing: 2, done: 3, tuning: 4, priming: 5, error: -1 };\nconst state = String(s.state || \"unknown\");\nmsg.payload = [{\n  state: state,\n  state_code: state in codes ? codes[state] : -2,\n  progress: Number(s.progress) || 0,\n  rssi: Number(s.rssi) || 0,\n  order_id: String(s.order || \"\")\n}, { device: String(s.device || \"esp32\") }];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
