  {
    "id": "httpOrder",
    "type": "http in",
    "z": "tab_main",
    "name": "POST /api/order",
    "url": "/api/order",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 150,
    "y": 100,
    "wires": [
      [
        "validate"
      ]
    ]
  },
  {
    "id": "validate",
    "type": "function",
    "z": "tab_main",
    "name": "Validate & hitung dosis",
    "func": "// Input: msg.payload = JSON dari QR (dikirim halaman scanner)\nconst o = msg.payload || {};\nconst bad = (code, status, error) => {\n  msg.statusCode = status;\n  msg.payload = { ok: false, code, error };\n  return [null, null, msg];\n};\n\nif (o.v !== 1) return bad(\"invalid\", 400, \"Versi format (v) harus 1\");\nif (typeof o.id !== \"string\" || !o.id || o.id.length > 64) return bad(\"invalid\", 400, \"Field id tidak valid\");\nfor (const k of [\"r\", \"g\", \"b\"]) {\n  if (!Number.isInteger(o[k]) || o[k] < 0 || o[k] > 255) return bad(\"invalid\", 400, \"Nilai \" + k + \" harus integer 0-255\");\n}\nif (typeof o.vol !== \"number\" || o.vol <= 0 || o.vol > 5000) return bad(\"invalid\", 400, \"Volume harus 1-5000 ml\");\n\nconst esp = flow.get(\"espStatus\") || {};\nif ([\"mixing\", \"tuning\", \"priming\"].includes(esp.state)) return bad(\"busy\", 409, \"Mixer sedang sibuk (\" + esp.state + (esp.order ? \" order \" + esp.order : \"\") + \")\");\n\nconst done = flow.get(\"processedIds\") || [];\nif (done.includes(o.id) && !o.force) return bad(\"duplicate\", 409, \"Order sudah pernah diproses\");\n\n// RGB -> takaran cat dasar Merah, Hijau, Biru (ml), sebanding dengan nilai R:G:B.\n// Sama dengan computeDose() di web/common.js\nlet sum = o.r + o.g + o.b;\nconst parts = sum > 0 ? { red: o.r, green: o.g, blue: o.b } : { red: 1, green: 1, blue: 1 };\nif (sum === 0) sum = 3;   // RGB(0,0,0): campur rata (hasilnya gelap)\nconst dose = {};\nfor (const p in parts) dose[p] = Math.round(parts[p] / sum * o.vol * 10) / 10;\n\nconst hex = \"#\" + [o.r, o.g, o.b].map(v => v.toString(16).padStart(2, \"0\")).join(\"\").toUpperCase();\nconst order = {\n  id: o.id,\n  name: String(o.name || \"Custom\").slice(0, 32),\n  r: o.r, g: o.g, b: o.b, hex: hex,\n  vol: o.vol,\n  dose: dose,\n  ts: Date.now()\n};\nflow.set(\"processedIds\", [o.id].concat(done.filter(x => x !== o.id)).slice(0, 200));\n\n// 1) ke ESP32\nconst mqttMsg = { topic: \"colormix/order\", payload: order };\n// 2) ke InfluxDB: [fields, tags]\nconst influxMsg = { payload: [{\n  r: o.r, g: o.g, b: o.b, vol: o.vol,\n  red_ml: dose.red, green_ml: dose.green, blue_ml: dose.blue,\n  name: order.name, hex: hex, order_id: o.id\n}, { source: \"scanner\" }] };\n// 3) balasan HTTP ke scanner\nmsg.statusCode = 200;\nmsg.payload = { ok: true, order: order };\nif (!esp.state || esp.state === \"offline\") {\n  msg.payload.warning = \"ESP32 sedang offline - order tetap dipublish, tapi mungkin tidak diterima\";\n}\nreturn [mqttMsg, influxMsg, msg];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [
      [
        "mqttOrder",
        "dbgOrder"
      ],
      [
        "influxOrders"
      ],
      [
        "httpRes1"
      ]
    ],
    "outputLabels": [
      "MQTT ke ESP32",
      "InfluxDB",
      "HTTP response"
    ]
  },
